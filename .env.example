# ───────────────────────────────────────────────────────────────────────────
# Crafted MFG — environment variables
# Copy to .env (root, for scripts), apps/web/.env.local, and apps/mobile/.env
# as noted per variable. Never commit real values.
# ───────────────────────────────────────────────────────────────────────────

# ── Supabase (all clients) ──────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Web (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Mobile (apps/mobile/.env)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — used by scripts/seed-users.mjs and Supabase Edge Functions.
# NEVER ship to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── QuickBooks Online (Intuit) — Phase 1 ───────────────────────────────────
# From: https://developer.intuit.com → your app → Keys & credentials.
# Use the Sandbox keys first. Set these as Supabase Edge Function secrets:
#   supabase secrets set QBO_CLIENT_ID=... QBO_CLIENT_SECRET=... ...
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" or "production"
QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI registered on the Intuit app:
# https://<project-ref>.functions.supabase.co/qbo-oauth/callback
QBO_REDIRECT_URI=
# Where the qbo-oauth callback sends the admin's browser after connecting
QBO_APP_RETURN_URL=http://localhost:3000/admin/qbo

# ── Carriers — Phase 2 (not used in MVP; reserved) ──────────────────────────
# TODO(creds): UPS OAuth client credentials — https://developer.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# TODO(creds): FedEx Track API OAuth credentials — https://developer.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# TODO(creds): DHL tracking API key — https://developer.dhl.com
DHL_API_KEY=

# ── Seed script (scripts/seed-users.mjs) ────────────────────────────────────
# Password assigned to the three demo users it creates
SEED_USER_PASSWORD=crafted-demo-1234
