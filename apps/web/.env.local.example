# Copy to apps/web/.env.local and fill in from your Supabase project settings
# (Project Settings → API).

# Your Supabase project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon (public) API key. RLS enforces all access control server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
